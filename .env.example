## PORTS
API_PORT=8000
WEB_PORT=4300

## Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# SMTP (local MailHog)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Zando RDC Support <support@zando-rdc.local>

# Session configuration
SESSION_SECRET=
SESSION_MAX_AGE=

# JWT Secret
JWT_SECRET=
JWT_AUTH_TOKEN_EXPIRERS_IN=

# Google
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GOOGLE_REDIRECT_URI=
FRONTEND_URI=

# Production web: public API base URL at build time; exact SSR hosts at runtime.
# /api requires a reverse proxy that strips /api before forwarding to the API.
WEB_API_URL=/api
WEB_ALLOWED_HOSTS=localhost,127.0.0.1
